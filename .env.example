# CodeBuddy API Key
# 请填写您的 CodeBuddy API Key
CODEBUDDY_API_KEY=your_api_key_here

# 可选：Auth Token
# CODEBUDDY_AUTH_TOKEN=your_auth_token_here

# 可选：Internet Environment
# CODEBUDDY_INTERNET_ENVIRONMENT=default

# 可选：Base URL
# CODEBUDDY_BASE_URL=https://api.codebuddy.cn

# ==================== 自定义模型配置 ====================

# Ollama 本地模型配置
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# OpenAI 模型配置（可选）
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 模型配置（可选）
# CUSTOM_MODEL_ID=deepseek-chat
# CUSTOM_MODEL_NAME=DeepSeek Chat
# CUSTOM_MODEL_BASE_URL=https://api.deepseek.com/v1

# 自定义模型配置（可选）
# CUSTOM_MODEL_ID=my-model
# CUSTOM_MODEL_NAME=我的模型
# CUSTOM_MODEL_BASE_URL=https://api.example.com/v1